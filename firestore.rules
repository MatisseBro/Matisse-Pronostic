rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Administrateur ────────────────────────────────────────────────────────
    // UID visible dans Firebase Console → Authentication → Users → colonne UID.
    // Ne pas reproduire cette valeur dans le code Flutter.
    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "uFiFjKTYUzSDlPITAC7gx9ElPcC3";
    }

    // Lecture robuste d'un champ potentiellement absent (ex. authorUid legacy).
    function field(data, key) {
      return data.get(key, null);
    }


    // ═════════════════════════════════════════════════════════════════════════
    // Collection : predictions
    // Chaque utilisateur possède ses propres pronostics.
    // L'admin conserve un accès étendu pour : résultats + documents legacy.
    // ═════════════════════════════════════════════════════════════════════════
    match /predictions/{predId} {

      // Lecture : tout utilisateur authentifié peut lire tous les pronostics.
      allow read: if request.auth != null;

      // Création : authorUid doit correspondre à l'utilisateur connecté.
      // Interdit d'écrire authorUid = null ou authorUid = uid_d_un_autre.
      allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;

      // Mise à jour :
      //   Règle (1) — authorUid IMMUABLE : la valeur ne peut jamais changer.
      //               Utilise field() pour gérer l'absence totale du champ (legacy).
      //   Règle (2) — au moins une condition d'accès doit être vraie :
      //     (a) Propriétaire — peut modifier tous ses champs (sauf authorUid).
      //     (b) Admin — peut modifier UNIQUEMENT 'result' sur n'importe quel prono.
      //     (c) Admin — peut tout modifier sur les pronos legacy (authorUid absent/null).
      allow update: if request.auth != null
          // (1) authorUid immutable
          && field(request.resource.data, 'authorUid') == field(resource.data, 'authorUid')
          && (
            // (2a) propriétaire
            field(resource.data, 'authorUid') == request.auth.uid
            // (2b) admin → uniquement le champ 'result'
            || (isAdmin()
                && request.resource.data.diff(resource.data)
                                        .affectedKeys()
                                        .hasOnly(['result']))
            // (2c) admin → prono legacy (authorUid absent ou null)
            || (isAdmin() && field(resource.data, 'authorUid') == null)
          );

      // Suppression :
      //   - Propriétaire supprime le sien.
      //   - Admin supprime les pronos legacy (authorUid absent/null).
      //   - L'admin NE PEUT PAS supprimer le prono d'un autre utilisateur.
      allow delete: if request.auth != null
          && (
            field(resource.data, 'authorUid') == request.auth.uid
            || (isAdmin() && field(resource.data, 'authorUid') == null)
          );
    }


    // ═════════════════════════════════════════════════════════════════════════
    // Collection : users
    // Profils + sous-collections friends, friendRequests, received.
    // ═════════════════════════════════════════════════════════════════════════
    match /users/{uid} {

      // Lecture du profil : tout utilisateur authentifié peut chercher par email
      // (UserService.findByEmail utilise une query sur la collection entière).
      allow read: if request.auth != null;

      // Création du profil (ensureProfile → set() sur nouveau document) :
      //   - Le chemin {uid} correspond à l'UID Firebase Auth de l'appelant.
      //   - Le champ 'uid' du document est identique au chemin.
      //   - Le champ 'email' correspond à l'email du token Firebase Auth.
      allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email;

      // Mise à jour du profil (displayName, deviceId) :
      //   - Seul le propriétaire peut modifier son profil.
      //   - 'uid' et 'email' sont immuables après création.
      //   - 'deviceId' doit respecter le format "MatiMatch_XXXXXXXXXXXX"
      //     ou être null (dissociation de l'appareil).
      allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid   == resource.data.uid
          && request.resource.data.email == resource.data.email
          && (
            field(request.resource.data, 'deviceId') == null
            || field(request.resource.data, 'deviceId').matches('MatiMatch_[0-9A-Fa-f]{12}')
          );

      // Suppression du profil interdite depuis le client.


      // ── Sous-collection : friends ─────────────────────────────────────────
      // Chaque document représente un ami : users/{uid}/friends/{friendUid}
      //
      // ⚠️ Problème de la relation bidirectionnelle :
      //   SocialService.addFriend() écrit dans les deux listes via un batch.
      //   Alice (auth.uid=A) écrit users/A/friends/B (sa liste → règle owner)
      //   ET users/B/friends/A (liste de Bob → règle self-insert ci-dessous).
      //
      // Règle self-insert : Bob (friendUid=B, auth.uid=B) peut s'insérer dans
      //   la liste d'Alice (uid=A) si le document indique bien son propre uid.
      //   Ceci empêche Alice d'insérer Charlie dans la liste de Bob.
      //
      // ── Modèle futur (friendRequests) ────────────────────────────────────
      //   Pour un vrai système demande/acceptation, décommenter la section
      //   friendRequests ci-dessous et mettre à jour SocialService.addFriend()
      //   pour écrire users/{Bob}/friendRequests/{Alice} au lieu du batch direct.
      //   La règle self-insert deviendrait alors :
      //     allow create: if auth.uid == friendUid
      //         && exists(.../users/{friendUid}/friendRequests/{uid});
      //   (Bob peut s'insérer dans la liste d'Alice seulement si Alice lui a
      //   envoyé une demande préalable.)
      match /friends/{friendUid} {
        allow read: if request.auth.uid == uid;

        // Propriétaire gère sa propre liste (initiateur du batch).
        allow write: if request.auth.uid == uid;

        // Self-insert : l'utilisateur représenté par friendUid peut s'ajouter
        // à la liste de uid, à condition que le document contienne son propre uid.
        // Empêche : Alice d'ajouter Charlie dans la liste de Bob.
        allow create: if request.auth.uid == friendUid
            && request.resource.data.uid == request.auth.uid;

        // Self-remove : symétrique pour la suppression (SocialService.removeFriend).
        allow delete: if request.auth.uid == friendUid;
      }


      // ── Sous-collection : friendRequests (RÉSERVÉ — décommenter après migration) ──
      // Modèle demande/acceptation explicite.
      // Chaque document : users/{uid}/friendRequests/{senderUid}
      //   fromUid    : UID de l'expéditeur
      //   fromName   : Pseudonyme
      //   fromEmail  : Email
      //   status     : 'pending' (seule valeur autorisée à la création)
      //   createdAt  : horodatage
      //
      // match /friendRequests/{senderUid} {
      //   // Destinataire lit ses demandes entrantes.
      //   allow read: if request.auth.uid == uid;
      //
      //   // Expéditeur crée une demande en son propre nom.
      //   allow create: if request.auth.uid == senderUid
      //       && request.resource.data.fromUid == request.auth.uid
      //       && request.resource.data.status  == 'pending';
      //
      //   // Expéditeur peut annuler sa demande, destinataire peut l'accepter/rejeter.
      //   allow delete: if request.auth.uid == uid
      //       || request.auth.uid == senderUid;
      // }


      // ── Sous-collection : received ────────────────────────────────────────
      // Pronostics reçus d'un ami : users/{uid}/received/{predId}
      match /received/{predId} {

        // Lecture : uniquement le destinataire.
        allow read: if request.auth.uid == uid;

        // Création d'un pronostic partagé.
        //   (1) L'expéditeur est authentifié.
        //   (2) Le champ 'fromUid' correspond à son identité réelle.
        //       → empêche l'usurpation (Alice ne peut pas envoyer au nom de Bob).
        //   (3) L'expéditeur est un ami du destinataire.
        //       → empêche le spam vers des inconnus.
        allow create: if request.auth != null
            && request.resource.data.fromUid == request.auth.uid
            && exists(/databases/$(database)/documents
                      /users/$(uid)/friends/$(request.auth.uid));

        // Mise à jour : UNIQUEMENT la transition mqttStatus 'pending' → 'sent'.
        //   - Aucun autre champ ne peut être modifié après création.
        //   - L'expéditeur original est le seul autorisé.
        //   - L'amitié doit toujours exister.
        //   - La transition inverse ('sent' → 'pending') est interdite.
        allow update: if request.auth != null
            && resource.data.fromUid == request.auth.uid
            && exists(/databases/$(database)/documents
                      /users/$(uid)/friends/$(request.auth.uid))
            && request.resource.data.diff(resource.data)
                                    .affectedKeys()
                                    .hasOnly(['mqttStatus'])
            && resource.data.mqttStatus         == 'pending'
            && request.resource.data.mqttStatus == 'sent';

        // Suppression interdite depuis le client.
      }
    }

  }
}
